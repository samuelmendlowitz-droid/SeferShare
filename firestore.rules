rules_version = '2';

// TODO: replace "Sefer Share" with final platform name
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.isAdmin == true;
    }

    function isApprovedVendor(uid) {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(uid)).data.isVendor == true &&
        get(/databases/$(database)/documents/users/$(uid)).data.vendorApproved == true;
    }

    function isApprovedInstitutionOwner(uid) {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(uid)).data.isInstitutionOwner == true &&
        get(/databases/$(database)/documents/users/$(uid)).data.institutionOwnerApproved == true;
    }

    // --- Users -----------------------------------------------------------
    // wholesalePrice never lives here, but keep the profile itself locked down:
    // owners can edit their own info; only Cloud Functions (Admin SDK, which
    // bypasses these rules) or an admin may flip vendorApproved/institutionOwnerApproved/isAdmin.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.vendorApproved == resource.data.vendorApproved &&
        request.resource.data.get('institutionOwnerApproved', false) == resource.data.get('institutionOwnerApproved', false) &&
        request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
        request.resource.data.get('blocked', false) == resource.data.get('blocked', false);
      allow update: if isAdmin();
    }

    // --- Neshamos (shared dedication records) -----------------------------
    match /neshamos/{neshamaId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdByUid == request.auth.uid;
      // lastDedicatedAt is only ever changed server-side by the dedication
      // algorithm (Cloud Functions bypass these rules) — an owner editing their
      // neshama's details can't also bump it.
      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.createdByUid == request.auth.uid &&
        request.resource.data.get('lastDedicatedAt', null) == resource.data.get('lastDedicatedAt', null)
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.createdByUid == request.auth.uid);
    }

    // --- Institutions ------------------------------------------------------
    match /institutions/{institutionId} {
      allow read: if signedIn();
      // Only an approved institution owner may create one, and every new
      // institution starts unverified — verification is a separate, admin-only
      // step per institution (see functions/src/verifyInstitution.ts).
      allow create: if signedIn() &&
        request.resource.data.createdByUid == request.auth.uid &&
        isApprovedInstitutionOwner(request.auth.uid) &&
        request.resource.data.verified == false;
      // giftCardBalance and verified are only ever changed server-side (Cloud
      // Functions bypass these rules) — a gift card donation adds to the
      // balance, spending it subtracts, and only an admin verifies.
      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.createdByUid == request.auth.uid &&
        request.resource.data.get('giftCardBalance', 0) == resource.data.get('giftCardBalance', 0) &&
        request.resource.data.verified == resource.data.verified
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.createdByUid == request.auth.uid);
    }

    // --- Sefarim catalog (public fields only — wholesalePrice lives elsewhere) --
    match /sefarim/{seferId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (signedIn() && isApprovedVendor(request.auth.uid));
      allow delete: if isAdmin();
    }

    // --- Vendor-private pricing (wholesalePrice) — never client-readable except by owner/admin --
    match /vendorPricing/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.vendorId == request.auth.uid);
      allow write: if isAdmin() || (
        signedIn() &&
        isApprovedVendor(request.auth.uid) &&
        request.resource.data.vendorId == request.auth.uid
      );
    }

    // --- Campaigns -----------------------------------------------------------
    match /campaigns/{campaignId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdByUid == request.auth.uid;
      // Campaigners can edit their own campaign, but fulfillment counters are
      // owned by the server-side algorithm (Cloud Functions bypass these rules).
      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.createdByUid == request.auth.uid &&
        request.resource.data.totalItemsFulfilled == resource.data.totalItemsFulfilled &&
        request.resource.data.currentMilestone == resource.data.currentMilestone
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.createdByUid == request.auth.uid);
    }

    // --- Donations — created and mutated only by Cloud Functions --------------
    match /donations/{donationId} {
      allow read: if signedIn() && (resource.data.donorUid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // --- Sticker designs — a designer's own saved-design library (visual
    // choices only, never the donation-specific dedication text); fully
    // owner-managed, client-side (view/name/edit/delete) ------------------------
    match /stickerDesigns/{designId} {
      allow read: if signedIn() && (resource.data.createdByUid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.createdByUid == request.auth.uid);
    }

    // --- Orders — admin-only end to end now: admin receives the order, forwards
    // it to the vendor outside the app, and tracks fulfillment itself. Vendors no
    // longer read or manage their own orders in-app. -------------------------
    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    // --- Available stock — seforim donated with no destination, sitting free
    // for any verified institution to claim; written and decremented only by
    // Cloud Functions (confirmDonation.ts / claimAvailableStock.ts). --------
    match /availableStock/{stockId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // --- Notifications — created by Cloud Functions, recipient can mark read --
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if signedIn() && resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if isAdmin();
    }
  }
}

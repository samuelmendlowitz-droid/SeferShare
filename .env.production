# Firebase's web config is not secret (security comes from Firestore/Storage rules,
# not from hiding these values), so it's safe to commit here. This guarantees any CI
# build — Cloudflare, Firebase Hosting, etc. — has real values baked in by Vite
# regardless of whether that host's dashboard actually exposes its env vars to the
# build step (Cloudflare's unified Workers dashboard did not, at least as configured).
VITE_FIREBASE_API_KEY=AIzaSyBdjnfGpdJCQSTCMQgsafZuPij6C2w6zNE
VITE_FIREBASE_AUTH_DOMAIN=sefershare.web.app
VITE_FIREBASE_PROJECT_ID=sefershare
VITE_FIREBASE_STORAGE_BUCKET=sefershare.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=712313417324
VITE_FIREBASE_APP_ID=1:712313417324:web:f397da32cd2fc687d0b249
